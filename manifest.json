{
  "manifest_version": 3,
  "name": "GST Report Downloader",
  "version": "0.6.0",
  "description": "Persistent black-and-white GST Returns panel with taxpayer profile, filing-status checks and authenticated report downloads.",
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "scripting",
    "downloads"
  ],
  "host_permissions": [
    "https://return.gst.gov.in/*",
    "https://services.gst.gov.in/*",
    "https://files.gst.gov.in/*"
  ],
  "action": {
    "default_title": "Open or close movable GST Report Downloader"
  },
  "content_scripts": [
    {
      "matches": [
        "https://return.gst.gov.in/*",
        "https://services.gst.gov.in/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "service_worker.js"
  }
}
